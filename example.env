# UDP listen address. The dashboard dials xexds.xboxlive.com on port 3074, so keep 3074 on
# the public side; the server must see each client's real source address and port (host
# networking or a published port that does not rewrite it), because it echoes them back.
X360_XEXDS_ADDR=:3074

# Optional. Signs the NAT-probe cookie (>= 16 bytes). Empty = a random key per process; a
# restart then only makes cookies in flight fail the (non-fatal) check.
# X360_XEXDS_KEY=change-me-cookie-key

# Optional. Log every datagram (debug level).
# X360_XEXDS_DEBUG=false
